      "PowerShell(git branch -D*)",
      "Bash(git branch -D*)",
      "PowerShell(git push --delete*)",
      "Bash(git push --delete*)",
      "PowerShell(git push -d*)",
      "Bash(git push -d*)",
      "PowerShell(git push origin :*)",
      "Bash(git push origin :*)",
      "PowerShell(Remove-Item -Recurse*)",
      "PowerShell(Remove-Item -Force*)",
      "Bash(rm -rf *)",
      "Bash(rm -fr *)",
      "Bash(rm -r *)",
      "PowerShell(kubectl delete *)",
      "Bash(kubectl delete *)",
      "PowerShell(az boards work-item delete*)",
      "Bash(az boards work-item delete*)",
      "PowerShell(az repos delete*)",
      "Bash(az repos delete*)",
      "PowerShell(az pipelines delete*)",
      "Bash(az pipelines delete*)"
    ],
    "defaultMode": "auto"
  },
  "autoMode": {
    "environment": [
      "$defaults",
      "Solo developer on Windows; Azure DevOps + GitHub; non-dev databases only through ~/.claude/scripts/db-ro.ps1"
    ],
    "allow": [
      "$defaults",
      "Read-only az devops/boards/repos/pipelines and gh queries",
      "dotnet build/test, npm test, docker compose ps/logs"
    ],
    "soft_deny": [
      "$defaults",
      "Any command that writes to a database not on localhost",
      "git push to the default branch",
      "Deleting a branch, worktree, volume or cloud resource",
      "Editing files under ~/.claude without the user's explicit request this turn, except memory, plans, jobs and worklog"
    ],
    "hard_deny": [
      "$defaults"
    ]
  },
  "model": "opus",
  "fallbackModel": ["sonnet", "haiku"],
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Agent|Task",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "-e",
              "try{require((process.env.CLAUDE_HOOKS||require('os').homedir()+'/.claude/hooks')+'/agent-guard.js')}catch{process.exit(0)}"
            ],
            "timeout": 15,
            "statusMessage": "Checking the subagent spawn..."
          }
        ]
      },
      {
        "matcher": "mcp__plugin_browser-use_browser-use__.*",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "-e",
              "try{require((process.env.CLAUDE_HOOKS||require('os').homedir()+'/.claude/hooks')+'/edge-cdp.js')}catch{process.exit(0)}"
            ],
            "timeout": 30,
            "statusMessage": "Checking Edge's CDP port for browser-use..."
          }
        ]
      },
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "-e",
              "require((process.env.CLAUDE_HOOKS||require('os').homedir()+'/.claude/hooks')+'/guard-shell.js')"
            ],
            "timeout": 15,
            "onFailure": "block",
            "statusMessage": "Checking the command before it runs..."
          }
        ]
      },
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "-e",
              "require((process.env.CLAUDE_HOOKS||require('os').homedir()+'/.claude/hooks')+'/secret-scan.js')"
            ],
            "timeout": 15,
            "onFailure": "block",
            "statusMessage": "Scanning the change for credentials..."
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "-e",
              "try{require((process.env.CLAUDE_HOOKS||require('os').homedir()+'/.claude/hooks')+'/format-on-edit.js')}catch{process.exit(0)}"
            ],
            "timeout": 30,
            "statusMessage": "Formatting the file just written..."
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "-e",
              "try{require((process.env.CLAUDE_HOOKS||require('os').homedir()+'/.claude/hooks')+'/workspace-context.js')}catch{process.exit(0)}"
            ],
            "timeout": 10,
            "statusMessage": "Resolving the ALM target and az identity for this workspace..."
          },
          {
            "type": "command",
            "command": "node",
            "args": [
              "-e",
              "try{require((process.env.CLAUDE_HOOKS||require('os').homedir()+'/.claude/hooks')+'/session-brief.js')}catch{process.exit(0)}"
            ],
            "timeout": 10,
            "statusMessage": "Reading the repository state..."
          }
        ]
      },
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "-e",
              "try{require((process.env.CLAUDE_HOOKS||require('os').homedir()+'/.claude/hooks')+'/worklog-pending.js')}catch{process.exit(0)}"
            ],
            "timeout": 10,
            "statusMessage": "Checking for days whose hours were never logged..."
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "-e",
              "try{require((process.env.CLAUDE_HOOKS||require('os').homedir()+'/.claude/hooks')+'/subagent-lang.js')}catch{process.exit(0)}"
            ],
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "-e",
              "try{require((process.env.CLAUDE_HOOKS||require('os').homedir()+'/.claude/hooks')+'/done-claim.js')}catch{process.exit(0)}"
            ],
            "timeout": 5
          }
        ]
      }
    ],
    "WorktreeCreate": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "-e",
              "require((process.env.CLAUDE_HOOKS||require('os').homedir()+'/.claude/hooks')+'/worktree-root.js')"
            ],
            "timeout": 90,
            "statusMessage": "Creating the worktree under CLAUDE_WORKTREE_ROOT..."
          }
        ]
      }
    ],
    "WorktreeRemove": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "-e",
              "require((process.env.CLAUDE_HOOKS||require('os').homedir()+'/.claude/hooks')+'/worktree-root.js')"
            ],
            "timeout": 60,
            "statusMessage": "Removing the worktree..."
          }
        ]
      }
    ]
  },
  "worktree": {
    "baseRef": "fresh"
  },
  "enableWorkflows": true,
  "workflowSizeGuideline": "small",
  "skipWorkflowUsageWarning": true,
  "workflowKeywordTriggerEnabled": false,
  "defaultShell": "powershell",
  "statusLine": {
    "type": "command",
    "command": "node \"$HOME/.claude/statusline.js\"",
    "refreshInterval": 5
  },
  "enabledPlugins": {
    "csharp-lsp@claude-plugins-official": true,
    "frontend-design@claude-plugins-official": true,
    "remember@claude-plugins-official": false,
    "microsoft-docs@claude-plugins-official": true,
    "skill-creator@claude-plugins-official": false,
    "chrome-devtools-mcp@claude-plugins-official": false,
    "redis-development@claude-plugins-official": false,
    "typescript-lsp@claude-plugins-official": true,
    "superpowers@claude-plugins-official": false,
    "modern-web-guidance@claude-plugins-official": false,
    "playwright@claude-plugins-official": false,
    "browser-use@claude-plugins-official": true
  },
  "outputStyle": "owner-80-20",
  "feedbackDrafts": "notify",
  "alwaysThinkingEnabled": true,
  "effortLevel": "medium",
  "advisorModel": "fable",
  "askUserQuestionTimeout": "never",
  "autoUpdatesChannel": "latest",
  "voice": {
    "enabled": true,
    "mode": "hold"
  },
  "theme": "dark",
  "editorMode": "normal",
  "preferredNotifChannel": "auto",
  "autoCompactEnabled": true,
  "inputNeededNotifEnabled": true,
  "agentPushNotifEnabled": true
}
