  "deniedMcpServers": [
    { "serverName": "claude.ai Microsoft 365" },
    { "serverName": "claude.ai Figma" },
    { "serverName": "claude.ai Airtable" }
  ],
  "autoMode": {
    "environment": [
      "$defaults",
      "Solo developer on Windows; Azure DevOps + GitHub; non-dev databases only through ~/.claude/scripts/db-ro.ps1"
    ],
    "allow": [
      "$defaults",
      "Read-only az devops/boards/repos/pipelines and gh queries",
      "dotnet build/test, npm test, docker compose ps/logs"
    ],
    "soft_deny": [
      "$defaults",
      "Any command that writes to a database not on localhost",
      "git push to the default branch",
      "Deleting a branch, worktree, volume or cloud resource",
      "Editing files under ~/.claude without the user's explicit request this turn, except memory, plans, jobs and worklog"
    ],
    "hard_deny": [
      "$defaults"
    ]
  },
  "model": "opus[1m]",
  "fallbackModel": ["sonnet", "haiku"],
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "mcp__plugin_browser-use_browser-use__.*",
        "hooks": [
          {
            "type": "command",
            "command": "pwsh",
            "args": [
              "-NoProfile",
              "-ExecutionPolicy",
              "Bypass",
              "-Command",
              "$d = if ($env:CLAUDE_HOOKS) { $env:CLAUDE_HOOKS } else { \"$HOME\\.claude\\hooks\" }; & \"$d\\ensure-edge-cdp.ps1\""
            ],
            "timeout": 30,
            "statusMessage": "Checking Edge's CDP port for browser-use..."
          }
        ]
      },
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "-e",
              "try{require((process.env.CLAUDE_HOOKS||require('os').homedir()+'/.claude/hooks')+'/guard-shell.js')}catch{process.exit(0)}"
            ],
            "timeout": 15,
            "statusMessage": "Checking the command before it runs..."
          }
        ]
      },
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "-e",
              "try{require((process.env.CLAUDE_HOOKS||require('os').homedir()+'/.claude/hooks')+'/secret-scan.js')}catch{process.exit(0)}"
            ],
            "timeout": 15,
            "statusMessage": "Scanning the change for credentials..."
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "-e",
              "try{require((process.env.CLAUDE_HOOKS||require('os').homedir()+'/.claude/hooks')+'/format-on-edit.js')}catch{process.exit(0)}"
            ],
            "timeout": 30,
            "statusMessage": "Formatting the file just written..."
          },
          {
            "type": "command",
            "command": "node",
            "args": [
              "-e",
              "try{require((process.env.CLAUDE_HOOKS||require('os').homedir()+'/.claude/hooks')+'/nudges.js')}catch{process.exit(0)}"
            ],
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "-e",
              "try{require((process.env.CLAUDE_HOOKS||require('os').homedir()+'/.claude/hooks')+'/nudges.js')}catch{process.exit(0)}"
            ],
            "timeout": 5
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "-e",
              "try{require((process.env.CLAUDE_HOOKS||require('os').homedir()+'/.claude/hooks')+'/workspace-context.js')}catch{process.exit(0)}"
            ],
            "timeout": 10,
            "statusMessage": "Resolving the ALM target and az identity for this workspace..."
          },
          {
            "type": "command",
            "command": "node",
            "args": [
              "-e",
              "try{require((process.env.CLAUDE_HOOKS||require('os').homedir()+'/.claude/hooks')+'/session-brief.js')}catch{process.exit(0)}"
            ],
            "timeout": 10,
            "statusMessage": "Reading the repository state..."
          }
        ]
      },
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "-e",
              "try{require((process.env.CLAUDE_HOOKS||require('os').homedir()+'/.claude/hooks')+'/worklog-pending.js')}catch{process.exit(0)}"
            ],
            "timeout": 10,
            "statusMessage": "Checking for days whose hours were never logged..."
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "-e",
              "try{require((process.env.CLAUDE_HOOKS||require('os').homedir()+'/.claude/hooks')+'/nudges.js')}catch{process.exit(0)}"
            ],
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "-e",
              "try{require((process.env.CLAUDE_HOOKS||require('os').homedir()+'/.claude/hooks')+'/done-claim.js')}catch{process.exit(0)}"
            ],
            "timeout": 5
          }
        ]
      }
    ],
    "WorktreeCreate": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "-e",
              "require((process.env.CLAUDE_HOOKS||require('os').homedir()+'/.claude/hooks')+'/worktree-root.js')"
            ],
            "timeout": 90,
            "statusMessage": "Creating the worktree under CLAUDE_WORKTREE_ROOT..."
          }
        ]
      }
    ],
    "WorktreeRemove": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "-e",
              "require((process.env.CLAUDE_HOOKS||require('os').homedir()+'/.claude/hooks')+'/worktree-root.js')"
            ],
            "timeout": 60,
            "statusMessage": "Removing the worktree..."
          }
        ]
      }
    ]
  },
  "worktree": {
    "baseRef": "fresh"
  },
  "enableWorkflows": true,
  "workflowSizeGuideline": "small",
  "workflowKeywordTriggerEnabled": false,
  "defaultShell": "powershell",
  "statusLine": {
    "type": "command",
    "command": "node \"$HOME/.claude/statusline.js\"",
    "refreshInterval": 2
  },
  "enabledPlugins": {
    "csharp-lsp@claude-plugins-official": true,
    "frontend-design@claude-plugins-official": true,
