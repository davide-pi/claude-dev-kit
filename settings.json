  },
  "language": "Italian",
  "outputStyle": "owner-80-20",
  "feedbackDrafts": "notify",
  "alwaysThinkingEnabled": true,
  "effortLevel": "medium",
  "advisorModel": "fable",
  "askUserQuestionTimeout": "never",
  "autoUpdatesChannel": "latest",
  "voice": {
