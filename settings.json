  "model": "opus[1m]",
  "fallbackModel": ["sonnet", "haiku"],
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "mcp__plugin_browser-use_browser-use__.*",
        "hooks": [
          {
            "type": "command",
            "command": "C:\\Program Files\\PowerShell\\7\\pwsh.exe",
            "args": [
              "-NoProfile",
              "-ExecutionPolicy",
              "Bypass",
              "-Command",
              "& \"$env:CLAUDE_HOOKS\\ensure-edge-cdp.ps1\""
            ],
            "timeout": 30,
            "statusMessage": "Checking Edge's CDP port for browser-use..."
          }
        ]
      },
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "-e",
              "try{require((process.env.CLAUDE_HOOKS||'')+'/guard-shell.js')}catch{process.exit(0)}"
            ],
            "timeout": 15,
            "statusMessage": "Checking the command before it runs..."
          }
        ]
      },
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "-e",
              "try{require((process.env.CLAUDE_HOOKS||'')+'/secret-scan.js')}catch{process.exit(0)}"
            ],
            "timeout": 15,
            "statusMessage": "Scanning the change for credentials..."
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "-e",
              "try{require((process.env.CLAUDE_HOOKS||'')+'/format-on-edit.js')}catch{process.exit(0)}"
            ],
            "timeout": 30,
            "statusMessage": "Formatting the file just written..."
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "-e",
              "try{require((process.env.CLAUDE_HOOKS||'')+'/session-brief.js')}catch{process.exit(0)}"
            ],
            "timeout": 10,
            "statusMessage": "Reading the repository state..."
          },
          {
            "type": "command",
            "command": "node",
            "args": [
              "-e",
              "try{require((process.env.CLAUDE_HOOKS||'')+'/worklog-pending.js')}catch{process.exit(0)}"
            ],
            "timeout": 10,
            "statusMessage": "Checking for days whose hours were never logged..."
          }
        ]
      }
    ]
  },
  "worktree": {
    "baseRef": "fresh"
  },
  "enableWorkflows": false,
  "defaultShell": "powershell",
  "statusLine": {
    "type": "command",
    "command": "node \"$HOME/.claude/statusline.js\""
  },
  "enabledPlugins": {
    "csharp-lsp@claude-plugins-official": true,
    "frontend-design@claude-plugins-official": true,
    "remember@claude-plugins-official": false,
    "microsoft-docs@claude-plugins-official": true,
    "skill-creator@claude-plugins-official": true,
    "chrome-devtools-mcp@claude-plugins-official": false,
    "redis-development@claude-plugins-official": false,
    "typescript-lsp@claude-plugins-official": true,
    "superpowers@claude-plugins-official": false,
    "modern-web-guidance@claude-plugins-official": false,
    "playwright@claude-plugins-official": false,
    "browser-use@claude-plugins-official": true
  },
  "language": "Italian",
  "feedbackDrafts": "notify",
  "alwaysThinkingEnabled": true,
  "effortLevel": "medium",
  "advisorModel": "fable",
  "askUserQuestionTimeout": "never",
  "autoUpdatesChannel": "latest",
  "voice": {
    "enabled": true,
    "mode": "hold"
  },
  "theme": "dark",
  "editorMode": "normal",
  "preferredNotifChannel": "auto",
  "autoCompactEnabled": false,
  "remoteControlAtStartup": true,
  "inputNeededNotifEnabled": true,
  "agentPushNotifEnabled": true,
  "voiceEnabled": true
}
