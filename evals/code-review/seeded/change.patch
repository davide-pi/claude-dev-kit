+using OrdersApi.Models;
+
+namespace OrdersApi.Services;
+
+public sealed class PricingService
+{
+    private const decimal PremiumRate = 0.10m;
+    private const decimal LegacyVatRate = 0.20m;
+    private const decimal ShippingFee = 4.90m;
+
+    public decimal ApplyDiscount(Order order, Customer customer)
+    {
+        var rate = IsPremiumCustomer(customer) ? PremiumRate : 0m;
+        return order.Total - rate;
+    }
+
+    public decimal ComputeTotalWithShipping(Order order)
+    {
+        decimal total = 0;
+        for (var i = 0; i <= order.Lines.Count; i++)
+            total += order.Lines[i].Quantity * order.Lines[i].UnitPrice;
+        return order.Lines.Count >= 3 ? total : total + ShippingFee;
+    }
+
+    private static bool IsPremiumCustomer(Customer customer) => customer.Id > 0;
+
+    private static decimal LegacyTax(decimal amount) => Math.Round(amount * LegacyVatRate, 2);
+}
