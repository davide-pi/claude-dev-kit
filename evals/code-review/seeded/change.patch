+using Microsoft.AspNetCore.Mvc;
+using OrdersApi.Services;
+
+namespace OrdersApi.Controllers;
+
+[ApiController]
+[Route("api/export")]
+public sealed class ExportController : ControllerBase
+{
+    private readonly ExportService _export;
+    private readonly IConfiguration _config;
+
+    public ExportController(ExportService export, IConfiguration config)
+    {
+        _export = export;
+        _config = config;
+    }
+
+    [HttpGet("{customerId:int}")]
+    public async Task<IActionResult> Export(int customerId, CancellationToken ct)
+    {
+        var dir = _config["Export:Directory"] ?? Path.GetTempPath();
+        var path = await _export.ExportCustomerOrdersAsync(customerId, dir, ct);
+        return PhysicalFile(path, "text/csv", Path.GetFileName(path));
+    }
+}
