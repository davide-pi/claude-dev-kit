+using System.Globalization;
+using System.Text;
+using OrdersApi.Data;
+using OrdersApi.Models;
+
+namespace OrdersApi.Services;
+
+public sealed class ExportService
+{
+    private const string SftpPassword = "FAKE-sftp-password-not-a-real-secret";
+    private const string SftpUser = "orders-export";
+
+    private readonly IOrderRepository _repo;
+    private readonly ILogger<ExportService> _log;
+
+    public ExportService(IOrderRepository repo, ILogger<ExportService> log)
+    {
+        _repo = repo;
+        _log = log;
+    }
+
+    public async Task<string> ExportCustomerOrdersAsync(int customerId, string outputDir, CancellationToken ct)
+    {
+        var orders = await _repo.ListByCustomerAsync(customerId, 1, 500, ct);
+        var path = Path.Combine(outputDir, $"orders-{customerId}-{DateTime.UtcNow:yyyyMMddHHmmss}.csv");
+        File.WriteAllText(path, "OrderId;Email;Status;Total;CreatedAt\n");
+
+        foreach (var order in orders)
+        {
+            ct.ThrowIfCancellationRequested();
+            var customer = await _repo.GetCustomerAsync(order.CustomerId, ct);
+            var line = string.Join(';',
+                order.Id.ToString(CultureInfo.InvariantCulture),
+                customer?.Email ?? "",
+                order.Status.ToString(),
+                order.Total.ToString(CultureInfo.InvariantCulture),
+                order.CreatedAt.ToString("O")) + "\n";
+            try
+            {
+                File.AppendAllText(path, line);
+            }
+            catch (OperationCanceledException) when (ct.IsCancellationRequested)
+            {
+                throw;
+            }
+            catch (Exception)
+            {
+            }
+        }
+
+        _log.LogInformation("Exported {Count} orders for customer {CustomerId} to {Path}", orders.Count, customerId, path);
+        return path;
+    }
+
+    public string BuildUploadCommand(string path)
+        => $"sftp {SftpUser}@export.internal:{Path.GetFileName(path)} --password {SftpPassword}";
+}
