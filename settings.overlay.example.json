{
  "language": "Italian",
  "model": "sonnet",
  "effortLevel": "high",
  "outputStyle": "my-output-style",
  "alwaysThinkingEnabled": null,
  "env": {
    "CLAUDE_PERSONAL_REPOS": "owner/repo, owner/other-repo"
  },
  "permissions": {
