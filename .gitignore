# Machine-local Claude Code state — never commit (paths, session content, credentials)
.claude/settings.local.json
.claude/**/*.local.json
.remember/
# Anchored: the runtime output lives at the config root (`~/.claude/worklog/`), and unanchored it
# would also swallow anything new under the tracked `skills/worklog/`.
/worklog/

# Backups / editor / OS noise
*.bak
*.bkp
*.bak.*
*~
Thumbs.db
.DS_Store
