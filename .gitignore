# Machine-local Claude Code state — never commit (paths, session content, credentials)
.claude/settings.local.json
.claude/**/*.local.json
.remember/
# Anchored: the runtime output lives at the config root (`~/.claude/worklog/`), and unanchored it
# would also swallow anything new under the tracked `skills/worklog/`.
/worklog/
# plan-work's plan files: working notes between sessions, never committed (docs/delivery.md).
/docs/plans/
# `claude plugin eval` writes run results here unless --output-dir says otherwise.
/evals/results/

# .NET build output (eval fixtures)
**/bin/
**/obj/

# Backups / editor / OS noise
*.bak
*.bkp
*.bak.*
*~
Thumbs.db
.DS_Store
/settings.overlay.json

# Engine-generated declarations and the check's scratch dir inside a mod
/mods/*/.claude-plugin/types/
